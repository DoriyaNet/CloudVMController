# All provider settings can be managed from the Web UI:
#   http://127.0.0.1:4173/#settings
#
# Manage this file with: cloudvm env list|get|set|unset
# Install-time overrides: install.sh --env KEY=VALUE (Windows: -SetEnv)
#
# Local mode stores encrypted credentials in data/settings.json.
# GitHub mode stores an encrypted vault in a private GitHub repository at
# .cloudvm/vault.json. The server never writes vault plaintext to disk.

# Authentication mode:
#   github  GitHub App login + private repository vault
#   local   Legacy local data/settings.json mode
# If unset, github is used when all GitHub App values below are configured.
# CLOUDVM_AUTH_MODE=

# Only bind to localhost by default. A non-loopback HOST is refused in local
# mode unless CLOUDVM_ALLOW_INSECURE_REMOTE=1 is explicitly set.
HOST=127.0.0.1
PORT=4173

# GitHub App configuration for vault mode.
# Create an App with:
#   OAuth callback URL: https://YOUR_DOMAIN/api/auth/callback
#   Setup URL:          https://YOUR_DOMAIN/api/github/setup
#   Permissions:        Contents read/write, Metadata read-only
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Quoted multiline PEM, or a single line with literal \n escapes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# At least 32 random bytes. Encrypts OAuth/session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Optional canonical origin. Recommended behind a reverse proxy.
# APP_ORIGIN=https://cloudvm.example.com
#
# Force Secure cookies when TLS is terminated before Node and APP_ORIGIN is
# not set to an https URL.
# CLOUDVM_SECURE_COOKIES=1

# Optional allowlist. When empty, any authenticated GitHub user can use the
# panel only if CLOUDVM_ALLOW_ANY_GITHUB_USER=1 is also set. For a single-user
# deployment, set at least one of these values.
# CLOUDVM_ALLOWED_GITHUB_USERS=your-github-login
# CLOUDVM_ALLOWED_GITHUB_IDS=12345678
# CLOUDVM_ALLOW_ANY_GITHUB_USER=1

# Trust X-Forwarded-Host / X-Forwarded-Proto from a local reverse proxy.
# CLOUDVM_TRUST_PROXY=1

# Escape hatch for legacy local mode on a non-loopback address. Only use this
# when authentication and HTTPS are enforced by a reverse proxy in front.
# CLOUDVM_ALLOW_INSECURE_REMOTE=1

# Local-only fallback token. Prefer adding tokens in the Web UI.
# All Web-managed tokens work together; this value is used only when none exist.
LINODE_API_TOKEN=

# Optional directory for local settings.json and .key (default: ./data).
# CLOUDVM_DATA_DIR=
#
# Legacy name kept for compatibility:
# LINODE_PILOT_DATA_DIR=

# Override only for compatible API proxies or testing.
LINODE_API_BASE=https://api.linode.com/v4
