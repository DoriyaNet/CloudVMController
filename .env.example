# All provider settings can be managed from the Web UI:
#   http://127.0.0.1:4173/#settings
# API tokens and the SOCKS proxy do NOT need to be placed in this file.

# Optional fallback token. Prefer adding tokens in the Web UI.
# A Web-managed active token takes precedence over this value.
LINODE_API_TOKEN=

# Only bind to localhost by default. See README.md before exposing this app.
HOST=127.0.0.1
PORT=4173

# Optional directory for encrypted settings.json and .key (default: ./data).
# LINODE_PILOT_DATA_DIR=

# Override only for compatible API proxies or testing.
LINODE_API_BASE=https://api.linode.com/v4
